generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum TrackedItemType {
  BOOK
  INTEREST
}

// M1: 追跡対象（気になる本 / 興味分野）を共通のモデルとして扱う
model TrackedItem {
  id        String                       @id @default(uuid())
  type      TrackedItemType
  title     String
  note      String?
  // 本の検索結果から登録した場合のメタデータ（type: BOOK のみ）
  author       String?
  thumbnailUrl String?
  // 外部書籍API（Google Books）のボリュームID。同じ本の重複登録を防ぐために使う。
  externalId   String?
  // M3: 埋め込みベクトル（intfloat/multilingual-e5-small, 384次元）。生成・更新はPythonワーカーが担う。
  embedding Unsupported("vector(384)")?
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  matches Match[]

  @@index([type])
  @@index([externalId])
}

enum ContentSource {
  YOUTUBE
}

// M2: 外部プラットフォームから収集した生コンテンツ
model Content {
  id           String                       @id @default(uuid())
  source       ContentSource
  sourceId     String
  title        String
  description  String?
  url          String
  thumbnailUrl String?
  channelTitle String?
  publishedAt  DateTime?
  collectedAt  DateTime                     @default(now())
  // M3: 埋め込みベクトル（intfloat/multilingual-e5-small, 384次元）
  embedding    Unsupported("vector(384)")?

  matches Match[]

  @@unique([source, sourceId])
}

// M3: 追跡対象 × 収集コンテンツ の意味的マッチング結果
model Match {
  id            String   @id @default(uuid())
  trackedItemId String
  contentId     String
  score         Float
  createdAt     DateTime @default(now())

  trackedItem TrackedItem @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)
  content     Content     @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([trackedItemId, contentId])
  @@index([contentId])
}
